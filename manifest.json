{
  "manifest_version": 3,
  "name": "Archive.is Lite Helper",
  "version": "1.6.1",
  "description": "Redirects current page to archive.is mirrors and auto-submits if not archived",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "Redirect to archive.is"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://archive.is/*",
        "https://archive.today/*",
        "https://archive.ph/*",
        "https://archive.li/*",
        "https://archive.vn/*",
        "https://archive.fo/*",
        "https://archive.md/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}