{
  "manifest_version": 3,
  "name": "Archive.is Lite Helper",
  "version": "1.2",
  "description": "Redirects current page to archive.is",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "Redirect to archive.is"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://archive.is/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}